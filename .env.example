# Copie para .env e ajuste. O arquivo .env não deve ser versionado.

# Senha do PostgreSQL local (obrigatória)
SYSAGROPEC_DB_SENHA=troque-esta-senha

# Primeiro acesso: cria a organização e o administrador se o banco estiver vazio.
SYSAGROPEC_ORGANIZACAO=Minha organização
SYSAGROPEC_ADMIN_NOME=Administrador
SYSAGROPEC_ADMIN_EMAIL=admin@exemplo.com.br
SYSAGROPEC_ADMIN_SENHA=

# "demo" carrega dados fictícios de demonstração em banco vazio (não use com dados reais).
SPRING_PROFILES_ACTIVE=
